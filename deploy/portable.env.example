# Optional persistent data directory override:
# DATA_DIR=/path/to/Tube2Pod data
# Optional paths to installed media tools:
# YTDLP_PATH=/path/to/yt-dlp
# FFMPEG_PATH=/path/to/ffmpeg
# FFPROBE_PATH=/path/to/ffprobe
# Optional HTTPS origin for public feeds:
# PUBLIC_BASE_URL=https://podcast.example.com
