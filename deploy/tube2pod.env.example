PUBLIC_BASE_URL=https://YOUR-MACHINE.YOUR-TAILNET.ts.net:8443
BIND_ADMIN=127.0.0.1:8400
BIND_PUBLIC=127.0.0.1:8401
DATA_DIR=/var/lib/tube2pod

OMNIVOICE_BASE_URL=http://127.0.0.1:8200

# Authentication mode: "tailscale" (default) or "password".
OMNIVOICE_AUTH_MODE=tailscale
# Required when OMNIVOICE_AUTH_MODE=tailscale.
OMNIVOICE_TAILNET_USER=owner@example.com

# Password-mode alternative: uncomment both lines below, comment out the
# tailscale lines above, and replace the placeholder with a long random value.
# Never commit a real secret or this populated env file.
# OMNIVOICE_AUTH_MODE=password
# OMNIVOICE_PASSWORD=change-me

CHUNK_CHARS=4500
OMNIVOICE_TIMEOUT_SECS=60
SYNTHESIS_TIMEOUT_SECS=7200

YTDLP_PATH=/usr/local/bin/yt-dlp
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

RUST_LOG=info,tower_http=info
