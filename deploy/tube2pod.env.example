# Optional direct public HTTPS origin; replace with your own hostname.
# PUBLIC_BASE_URL=https://podcast.example.com
BIND_ADMIN=127.0.0.1:8400
BIND_PUBLIC=127.0.0.1:8401
BIND_OWNER=127.0.0.1:8402
BIND_LAN=0.0.0.0:8403
DATA_DIR=/var/lib/tube2pod

YTDLP_PATH=/usr/local/bin/yt-dlp
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

RUST_LOG=info,tower_http=info
